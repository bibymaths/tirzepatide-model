    <listOfRules>
      <assignmentRule name="glomerular filtration rate" variable="GFR">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> f_renal_function </ci>
            <ci> GFR_base </ci>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction sboTerm="SBO:0000655" id="TMEX" name="renal excretion of the tirzepatide metabolites (TMEX)" reversible="false" compartment="Vki">
        <listOfReactants>
          <speciesReference species="tm_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="tm_urine" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <times/>
              <ci> GFR </ci>
              <cn sbml:units="l_per_ml"> 0.001 </cn>
              <ci> TMEX_f </ci>
              <ci> tm_ext </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
